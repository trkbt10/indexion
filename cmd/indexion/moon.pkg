import {
  "moonbitlang/core/argparse",
  "moonbitlang/async",
  "trkbt10/indexion/cmd/indexion/check" @check_cli,
  "trkbt10/indexion/cmd/indexion/explore" @explore_cli,
  "trkbt10/indexion/cmd/indexion/similarity" @similarity_cli,
  "trkbt10/indexion/cmd/indexion/plan" @plan_cli,
  "trkbt10/indexion/cmd/indexion/doc" @doc_cli,
  "trkbt10/indexion/cmd/indexion/perf" @perf_cli,
  "trkbt10/indexion/cmd/indexion/segment" @segment_cli,
  "trkbt10/indexion/cmd/indexion/kgf" @kgf_cli,
  "trkbt10/indexion/cmd/indexion/init" @init_cli,
  "trkbt10/indexion/cmd/indexion/update" @update_cli,
  "trkbt10/indexion/src/update",
  "trkbt10/indexion/cmd/indexion/digest" @digest_cli,
  "trkbt10/indexion/cmd/indexion/serve" @serve_cli,
  "trkbt10/indexion/cmd/indexion/grep" @grep_cli,
  "trkbt10/indexion/cmd/indexion/search" @search_cli,
  "trkbt10/indexion/cmd/indexion/mcp" @mcp_cli,
  "trkbt10/indexion/cmd/indexion/spec" @spec_cli,
  "trkbt10/indexion/cmd/indexion/wiki" @wiki_cli,
  "trkbt10/indexion/cmd/indexion/story" @story_cli,
  "trkbt10/indexion/cmd/indexion/identity" @identity_cli,
  "trkbt10/indexion/cmd/indexion/agent" @agent_cli,
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  targets: {
    "main.mbt": [ "native" ],
    "main_stub.mbt": [ "wasm", "wasm-gc", "js" ],
  },
)
